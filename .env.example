# ─── LAMA — Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── LLM Provider ──────────────────────────────────────────────────────────────
# The UI model switcher (Gemini / Claude) overrides AI_PROVIDER per request.
# When AI_PROVIDER is unset, auto-detects in this order:
#   GEMINI_API_KEY → ANTHROPIC_API_KEY → NVIDIA_API_KEY
# AI_PROVIDER=gemini

# Google Gemini  — free keys at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM (optional) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_NIM_BASE_URL=http://localhost:8000/v1

# ── Safety guardrail ──────────────────────────────────────────────────────────
# "builtin" = fast regex pass · "nemo" = NeMo Guardrails (requires nemoguardrails)
SAFETY_MODE=builtin

# ── Python agents service (FastAPI) ───────────────────────────────────────────
AGENTS_URL=http://localhost:8787
AGENTS_TIMEOUT_MS=30000

# ── Admin dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
