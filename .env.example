# ─── LAMA — Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── LLM — Ollama (used for every model call) ─────────────────────────────────
# Local dev: run the Ollama app and pull a model, e.g. `ollama pull qwen3:8b`,
#   then set OLLAMA_MODEL=qwen3:8b (or use a "<name>:cloud" model while signed in).
# Deployed (Vercel/Railway): they can't reach your PC, so use Ollama Cloud:
#   OLLAMA_BASE_URL=https://ollama.com, OLLAMA_API_KEY from https://ollama.com/settings/keys,
#   OLLAMA_MODEL set to a cloud model name without ":cloud" (e.g. gpt-oss:120b).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# Optional embedding model for the memory graph (local only, e.g. nomic-embed-text).
# Ollama Cloud has no embedding models; leave empty there.
OLLAMA_EMBED_MODEL=

# ── Safety guardrail ──────────────────────────────────────────────────────────
# "builtin" = fast regex pass · "nemo" = NeMo Guardrails (requires nemoguardrails)
SAFETY_MODE=builtin

# ── Python agents service (FastAPI) ───────────────────────────────────────────
AGENTS_URL=http://localhost:8787
AGENTS_TIMEOUT_MS=30000
# Shared secret between the web app and the agents service. Set the same value on
# both in production (Vercel + Railway); leave empty for local dev.
AGENTS_TOKEN=

# ── Admin dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
